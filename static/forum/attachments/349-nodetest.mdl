    subviewer		    32
    ssIdNumber		    1
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function out = convert3(decimal)\n%#eml\n\nbinary = zeros(1,3);\ndigits = uint8(3);\n\nwhile(digi"
      "ts)\n    if(mod(decimal,2))\n        binary(digits) = 1;\n        decimal = decimal/2 - 1;\n    else\n        bi"
      "nary(digits) = 0;\n        decimal = decimal/2;\n    end\n    digits = digits-1;\nend\n\nout = binary;\nend"
      editorLayout	      "100 M4x1[564 275 1080 733]"
    }
  }
