  state {
    id			    3
    labelString		    "eML_blk_kernel()"
    position		    [18 64.5 118 66]
    fontSize		    12
    chart		    2
    treeNode		    [2 0 0 0]
    superState		    SUBCHART
    subviewer		    2
    ssIdNumber		    1
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function [out_id,out_rts,out_data,out_data_buffer,status] = node1_send(data_in,id,cts,counter,dat"
      "a_buffer,status_buffer)    %data,id,cts,counter\n%#eml\nrts = uint8(1);\nsend = false;\nout_data_buffer = data_b"
      "uffer; %upkeep last data_buffer value\nstatus = status_buffer;\nacknowledged = uint8(1);\ndata_sent = uint8(3);\n"
      "\nif (counter == 0) \n    out_data_buffer = data_in;      %sample the input\n    send = true;\n    status = data"
      "_sent;\n    \nelseif (status ~= acknowledged)\n    if (cts == id)\n        status = acknowledged;\n    elseif (m"
      "od(counter,10)==0)  %.1ms and no ack, resend\n        send = true;\n    end\nend\n   \nif (send)\n    out_id = i"
      "d;\n    out_rts = rts;\n    out_data = out_data_buffer;\nelse\n    out_id = uint8(0);\n    out_rts = uint8(0);\n"
      "    out_data = uint8(0);\nend\n    "
      editorLayout	      "100 M4x1[103 135 1094 914]"
    }
  }
